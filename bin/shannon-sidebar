#!/usr/bin/env python3
"""shannon-sidebar — 左栏会话列表,按项目分组,点击在右栏就地打开。

纯标准库实现 (curses)。数据源: ~/.claude/projects 的会话记录 +
`claude agents --json` 的实时状态。由 shannon-workspace 放进 tmux 左栏;
折叠时收窄成 rail(面板不销毁),rail 底部保留展开按钮。
"""

import curses
import json
import os
import subprocess
import sys
import threading
import time
import unicodedata

HOME = os.path.expanduser("~")
PROJECTS_DIR = os.path.join(HOME, ".claude", "projects")
STATE_DIR = os.path.join(HOME, ".claude", "shannon")
SESSION = os.environ.get("SHANNON_SESSION", "shannon")
TOGGLE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "shannon-toggle")
AUTOFIT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "shannon-autofit")


def log(msg: str) -> None:
    try:
        with open(os.path.join(STATE_DIR, "sidebar.log"), "a") as fh:
            fh.write(f"{time.strftime('%H:%M:%S')} {msg}\n")
    except OSError:
        pass

SCAN_LIMIT = 48          # 最多读多少个最新的会话文件
REFRESH_SECS = 15        # 数据刷新周期
MAX_GROUPS = 12
PER_GROUP = 6
MIN_W_SAVE = 12          # 记忆展开宽度时的下限
MAX_W = 40               # 记忆/允许的展开宽度上限
W_COOLDOWN = 0.6         # 布局守卫纠宽的最小间隔(秒)
SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"  # 工作中: 动态菊花帧, 对齐 Claude Code

ACCENT = 209             # 珊瑚 #d7875f(近 Anthropic D97757)
GREEN = 114
YELLOW = 214
RED = 167


def load_config() -> dict:
    cfg = {"SIDEBAR_W": 35, "COLLAPSE_AT": 70, "RAIL_W": 2}
    try:
        with open(os.path.join(STATE_DIR, "config")) as fh:
            for line in fh:
                k, _, v = line.partition("=")
                k, v = k.strip(), v.strip()
                if k in cfg and v.isdigit():
                    cfg[k] = int(v)
    except OSError:
        pass
    return cfg


CFG = load_config()

# ---------------------------------------------------------------- 数据层

def cell_len(s: str) -> int:
    n = 0
    for c in s:
        n += 2 if unicodedata.east_asian_width(c) in "WF" else 1
    return n


def trunc(s: str, w: int) -> str:
    if cell_len(s) <= w:
        return s
    out, n = "", 0
    for c in s:
        cw = 2 if unicodedata.east_asian_width(c) in "WF" else 1
        if n + cw > w - 1:
            return out + "…"
        out += c
        n += cw
    return out


def clean_title(s: str) -> str:
    s = s.strip()
    if s.startswith("<command-name>"):
        end = s.find("</command-name>")
        if end > 0:
            return s[len("<command-name>"):end].strip()
    for tag in ("<command-name>", "</command-name>", "<command-message>",
                "</command-message>", "<command-args>", "</command-args>"):
        s = s.replace(tag, " ")
    return " ".join(s.split())


def ago(ms: float, now: float) -> str:
    m = int((now - ms) / 60000)
    if m < 1:
        return "now"
    if m < 60:
        return f"{m}m"
    h = m // 60
    if h < 24:
        return f"{h}h"
    return f"{h // 24}d"


def first_user_text(entry: dict) -> str:
    msg = entry.get("message")
    if not isinstance(msg, dict):
        return ""
    c = msg.get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        parts = [b.get("text", "") for b in c
                 if isinstance(b, dict) and b.get("type") == "text"]
        return " ".join(p for p in parts if p)
    return ""


def scan_sessions() -> list:
    """最新的会话记录 → [{id, cwd, project, title, mtime}]"""
    files = []
    try:
        for d in os.scandir(PROJECTS_DIR):
            if not d.is_dir():
                continue
            for f in os.scandir(d.path):
                if f.name.endswith(".jsonl"):
                    try:
                        files.append((f.stat().st_mtime, f.path))
                    except OSError:
                        pass
    except OSError:
        return []
    files.sort(reverse=True)
    files = files[:SCAN_LIMIT]

    rows = []
    for mtime, path in files:
        sid = os.path.basename(path)[:-6]
        project = os.path.basename(os.path.dirname(path))
        cwd = ""
        summary = ""
        first = ""
        try:
            with open(path, encoding="utf-8", errors="replace") as fh:
                for i, line in enumerate(fh):
                    if i >= 30:
                        break
                    try:
                        entry = json.loads(line)
                    except (ValueError, TypeError):
                        continue
                    if not isinstance(entry, dict):
                        continue
                    if not cwd and isinstance(entry.get("cwd"), str):
                        cwd = entry["cwd"]
                    etype = entry.get("type")
                    if etype == "summary" and not summary:
                        summary = str(entry.get("summary") or "")
                    elif (etype == "user" and not first
                          and not entry.get("isMeta")
                          and not entry.get("isSidechain")):
                        first = first_user_text(entry)
                    if cwd and summary and first:
                        break
        except OSError:
            continue
        title = clean_title(summary or first or "Untitled")
        rows.append({
            "id": sid,
            "cwd": cwd,
            "project": project,
            "title": title,
            "mtime": mtime * 1000,
        })
    return rows


def host_pane_id() -> str:
    try:
        with open(os.path.join(STATE_DIR, "host-pane")) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def sidebar_pane_id() -> str:
    try:
        with open(os.path.join(STATE_DIR, "sidebar-pane")) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def current_session_id() -> str:
    try:
        with open(os.path.join(STATE_DIR, "current-session")) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def set_current_session(sid: str) -> None:
    try:
        with open(os.path.join(STATE_DIR, "current-session"), "w") as fh:
            fh.write(sid + "\n")
    except OSError:
        pass


def save_expanded_width(w: int) -> None:
    try:
        with open(os.path.join(STATE_DIR, "sidebar-w"), "w") as fh:
            fh.write(f"{w}\n")
    except OSError:
        pass


def expanded_width() -> int:
    """上次记忆的展开宽度,非法时回退配置值"""
    fallback = CFG["SIDEBAR_W"]
    try:
        with open(os.path.join(STATE_DIR, "sidebar-w")) as fh:
            v = fh.read().strip()
        if v.isdigit() and MIN_W_SAVE <= int(v) <= MAX_W:
            return int(v)
    except OSError:
        pass
    return fallback


def window_width() -> str:
    r = tmux("display-message", "-p", "-t", f"{SESSION}:0", "#{window_width}")
    return r.stdout.strip() if r else ""


def live_status() -> dict:
    """{sessionId: status} — 来自 claude agents --json 的原始状态"""
    try:
        out = subprocess.run(
            ["claude", "agents", "--json"],
            capture_output=True, text=True, timeout=8,
        ).stdout
        arr = json.loads(out)
    except Exception:
        return {}
    live = {}
    for a in arr if isinstance(arr, list) else []:
        if not isinstance(a, dict):
            continue
        sid = a.get("sessionId") or a.get("id")
        if sid:
            live[sid] = str(a.get("status") or "")
    return live


def status_glyph(sid: str, live: dict) -> tuple:
    """(字符或 None=菊花动画, 状态种类) — 对齐 Claude Code fleet view:
    工作中=菊花(珊瑚) 等待输入=✱(黄) 完成/停止/历史=∙(灰)
    右栏正在显示的会话=✽(珊瑚) 失败=✱(红)"""
    st = live.get(sid)
    if st is None:
        return ("∙", "dim")                  # 历史(未运行)
    s = st.lower()
    if sid == current_session_id():
        return ("✽", "accent")               # 右栏当前会话
    if "input" in s or "wait" in s:
        return ("✱", "yellow")               # 等待用户输入
    if s in ("busy", "working", "active", "running"):
        return (None, "accent")              # 工作中(菊花)
    if s in ("done", "completed"):
        return ("∙", "dim")                  # 完成
    if "fail" in s or "error" in s:
        return ("✱", "red")                  # 失败
    return ("∙", "dim")                      # 已停止/退出


KIND_PAIR = {"accent": 5, "green": 8, "yellow": 9, "red": 10,
             "dim": 3, "idle": 3}
# 焦点行(灰底 236)的同色系变体
CURSOR_BG = {"accent": 15, "green": 16, "yellow": 17, "red": 18,
             "dim": 14, "idle": 14}
# 悬停: 对齐 fleet view —— 文字提亮, 不加底色
HOVER_FG = {"accent": 5, "green": 8, "yellow": 9, "red": 10,
            "dim": 4, "idle": 4}


# ---------------------------------------------------------------- 操作

def tmux(*args):
    try:
        return subprocess.run(
            ["tmux", *args], capture_output=True, text=True, timeout=8)
    except Exception:
        return None


def activate(row):
    """点击某条会话: 右栏宿主 respawn 加载该会话(任何项目都就地切换)。"""
    pane = host_pane_id()
    if not pane:
        return "找不到宿主面板"
    if row["id"] == current_session_id():
        return "已经在这里了"
    bin_dir = os.path.dirname(os.path.abspath(__file__))
    r = tmux("respawn-pane", "-k", "-t", pane, "-c", row["cwd"],
             "env", f"SHANNON_DIR={row['cwd']}",
             f"SHANNON_RESUME={row['id']}", f"{bin_dir}/shannon-host")
    if r is not None and r.returncode == 0:
        set_current_session(row["id"])
        name = os.path.basename(row["cwd"].rstrip("/")) or row["project"]
        return f"已切换到 {name}"
    return "切换失败"


# ---------------------------------------------------------------- 界面

class App:
    def __init__(self):
        self.lock = threading.Lock()
        self.rows = []
        self.live = {}
        self.ready = False
        self.version = 0
        self.stop = threading.Event()
        self.order = None            # 首次加载时冻结的排序基准(id → mtime)
        threading.Thread(target=self.refresh_loop, daemon=True).start()

        self.sel = 0            # 焦点行在 display 行里的序号
        self.focus_visible = True
        self.offset = 0         # 滚动
        self.rail = False       # rail 模式(收窄成细条)
        self.hover = None       # ('row', idx) | ('collapse',) | ('exit',) | ('rail',)
        self.msg = ""
        self.msg_until = 0.0
        self.footer_btn_x = -1
        self.exit_zone = None   # ✕ 退出 的点击范围
        self.row_at = {}        # 屏幕行号 → display 行序号
        self.last_pane_check = 0.0
        self.started_at = time.time()
        self.consec_err = 0
        self.last_fix = 0.0
        self.last_act = 0.0     # 点击动作防抖
        self.last_motion = 0.0
        self.last_saved_w = 0
        self.last_ww = None     # 上次见到的窗口宽度
        self.ww_changed_at = 0.0  # 窗口宽度最后变化时刻(区分缩放/拖分隔条)

    def act(self, fn):
        """点击动作防抖: 180ms 内的重复事件忽略"""
        now = time.time()
        if now - self.last_act < 0.18:
            return
        self.last_act = now
        fn()

    def quit_session(self):
        tmux("kill-session", "-t", SESSION)

    # -- 后台刷新 -----------------------------------------------------
    def refresh_loop(self):
        while not self.stop.is_set():
            rows = scan_sessions()
            live = live_status()
            with self.lock:
                if self.order is None:
                    # 冻结初始排序: 之后点击/加载不再扰动顺序
                    self.order = {r["id"]: r["mtime"] for r in rows}
                order = dict(self.order)
            for r in rows:
                r["_k"] = order.get(r["id"], r["mtime"])
            rows.sort(key=lambda r: r["_k"], reverse=True)
            with self.lock:
                self.rows = rows
                self.live = live
                self.ready = True
                self.version += 1
            self.stop.wait(REFRESH_SECS)

    def snapshot(self):
        with self.lock:
            return self.rows, self.live, self.ready, self.version

    # -- 展示模型 -----------------------------------------------------
    def display_items(self, rows):
        """[('group', name) | ('row', row)] — 分组、限量(顺序沿用 rows)"""
        groups = {}
        for r in rows:
            if r["cwd"]:
                name = os.path.basename(r["cwd"].rstrip("/")) or r["project"]
                groups.setdefault(name, []).append(r)
        items = []
        gs = sorted(groups.items(),
                    key=lambda kv: max(x["_k"] for x in kv[1]),
                    reverse=True)
        for name, g in gs[:MAX_GROUPS]:
            items.append(("group", name))
            for r in g[:PER_GROUP]:
                items.append(("row", r))
        return items

    # -- 绘制 ---------------------------------------------------------
    def draw(self, stdscr):
        try:
            self._draw(stdscr)
        except curses.error:
            pass          # 窗口极小时的角落写入报错,忽略即可

    def _draw(self, stdscr):
        rows, live, ready, _ = self.snapshot()
        now_ms = time.time() * 1000
        H, W = stdscr.getmaxyx()

        # rail 模式: 侧栏被收窄成细条,底部保留展开按钮
        if W <= CFG["RAIL_W"] + 2:
            self.rail = True
            stdscr.erase()
            gx = max(0, min(1, W - 2))
            if self.hover == ("rail",):
                stdscr.addnstr(H - 1, gx, "▶", 1, curses.color_pair(26)
                               | curses.A_BOLD)
            else:
                stdscr.addnstr(H - 1, gx, "▶", 1,
                               curses.color_pair(5) | curses.A_BOLD)
            stdscr.refresh()
            return
        self.rail = False

        items = self.display_items(rows)
        row_idx = [i for i, it in enumerate(items) if it[0] == "row"]
        self.sel = max(0, min(self.sel, len(row_idx) - 1))
        view_rows = max(1, H - 2)

        # 滚动: 焦点行保持可见
        if row_idx and self.focus_visible:
            sel_item = row_idx[self.sel]
            if sel_item < self.offset:
                self.offset = sel_item
            while (sel_item >= self.offset + view_rows
                   and self.offset < len(items)):
                self.offset += 1

        stdscr.erase()
        self.row_at = {}

        # 头部: SESSIONS 带灰色底带,与项目名明确区分
        band = curses.color_pair(12) | curses.A_BOLD
        stdscr.addnstr(0, 1, "SESSIONS", W - 2, band)
        if W > 9:
            stdscr.addnstr(0, 9, " " * (W - 9), W - 9, band)
        if row_idx:
            cnt = str(len(row_idx))
            stdscr.addnstr(0, max(2, W - 1 - cell_len(cnt)), cnt, W - 2, band)

        # 列表
        y = 1
        for i in range(self.offset, len(items)):
            if y > H - 2:
                break
            kind, payload = items[i]
            if kind == "group":
                stdscr.addnstr(y, 1, payload, W - 2,
                               curses.color_pair(2) | curses.A_BOLD)
            else:
                row = payload
                cursor = (self.focus_visible
                          and self.sel < len(row_idx)
                          and row_idx[self.sel] == i)
                hovered = self.hover == ("row", i)
                current = row["id"] == current_session_id()
                t = ago(row["mtime"], now_ms)
                gch, gkind = status_glyph(row["id"], live)
                room = max(6, W - cell_len(t) - 6)
                title = trunc(row["title"], room)
                if gch is None:   # 工作中 → 菊花当前帧
                    gch = SPINNER[int(now_ms / 120) % len(SPINNER)]
                if cursor:
                    a_title = curses.color_pair(13)
                    a_time = curses.color_pair(14)
                    a_glyph = curses.color_pair(CURSOR_BG.get(gkind, 14))
                elif hovered:
                    a_title = curses.color_pair(26)   # 悬停: 文字提亮
                    a_time = curses.color_pair(4)
                    a_glyph = curses.color_pair(
                        HOVER_FG.get(gkind, 4))
                else:
                    a_title = curses.color_pair(1)
                    a_time = curses.color_pair(3)
                    a_glyph = curses.color_pair(KIND_PAIR.get(gkind, 3))
                if current:
                    # 珊瑚竖条 + 珊瑚标题 = 右栏正在显示的会话(不随键盘焦点移动)
                    a_title = curses.color_pair(
                        15 if cursor else (22 if hovered else 5))
                    stdscr.addnstr(y, 1, "▌", 1,
                                   curses.color_pair(
                                       15 if cursor else (22 if hovered
                                                          else 5)))
                stdscr.addnstr(y, 2, title, W - 2, a_title)
                x_time = W - 2 - cell_len(gch) - 1 - cell_len(t)
                stdscr.addnstr(y, max(2, x_time), t, W - 2, a_time)
                stdscr.addnstr(y, W - 2, gch, 1, a_glyph)
                self.row_at[y] = i
            y += 1

        if not ready:
            stdscr.addnstr(1, 1, "loading…", W - 2, curses.color_pair(3))
        elif not rows:
            stdscr.addnstr(1, 1, "no conversations yet", W - 2,
                           curses.color_pair(3))

        # 底部: "✕ 退出"(左, 可点击) + "◀ 收起"(右, 可点击)
        btn = "◀ 收起"
        left = "✕ 退出"
        self.footer_btn_x = max(1, W - 1 - cell_len(btn))
        self.exit_zone = (1, cell_len(left))
        if self.hover == ("exit",):
            stdscr.addnstr(H - 1, 1, left, W - 2, curses.color_pair(26))
        else:
            stdscr.addnstr(H - 1, 1, left, W - 2, curses.color_pair(3))
        if self.hover == ("collapse",):
            stdscr.addnstr(H - 1, self.footer_btn_x, "◀", 1,
                           curses.color_pair(5) | curses.A_BOLD)
            stdscr.addnstr(H - 1, self.footer_btn_x + 1, " 收起",
                           W - self.footer_btn_x - 1, curses.color_pair(26))
        else:
            stdscr.addnstr(H - 1, self.footer_btn_x, "◀", 1,
                           curses.color_pair(5))
            stdscr.addnstr(H - 1, self.footer_btn_x + 1, " 收起",
                           W - self.footer_btn_x - 1, curses.color_pair(3))

        stdscr.refresh()

    def toast(self, m):
        self.msg = m
        self.msg_until = time.time() + 2.5
        self.last_version = -1          # 立即重画,让 toast 马上可见

    # -- 交互 ---------------------------------------------------------
    def move(self, row_idx, delta):
        if not row_idx:
            return
        self.focus_visible = True       # 上下键从当前焦点出发重新显示高亮
        self.sel = max(0, min(len(row_idx) - 1, self.sel + delta))

    def open_selected(self, items, row_idx):
        if not row_idx or self.sel >= len(row_idx):
            return
        self.toast(activate(items[row_idx[self.sel]][1]))

    def click(self, my, mx, H, items, row_idx):
        if self.rail:
            self.act(lambda: subprocess.run([TOGGLE]))   # rail 点击 → 展开
            return
        if my == H - 1:
            # 底部按钮区: ✕ 退出 · ◀ 收起(命中区放宽一格)
            if (self.exit_zone and self.exit_zone[0] <= mx <= self.exit_zone[1]):
                self.act(self.quit_session)
            elif mx >= self.footer_btn_x - 1:
                self.act(lambda: subprocess.run([TOGGLE]))
            return
        if my in self.row_at:
            idx = self.row_at[my]
            if idx < len(items) and items[idx][0] == "row":
                def open_row():
                    if idx in row_idx:
                        self.sel = row_idx.index(idx)   # 焦点跟随点击行
                    self.toast(activate(items[idx][1]))
                self.act(open_row)

    def right_pane_alive(self):
        pane = host_pane_id()
        if not pane:
            return True
        r = tmux("list-panes", "-t", f"{SESSION}:0", "-F", "#{pane_id}")
        ids = (r.stdout or "").split() if r else []
        alive = r is None or pane in ids
        if not alive:
            log(f"宿主面板消失判定: host-pane={pane} list-panes={ids} "
                f"rc={r.returncode if r else 'exc'}")
        return alive

    def run(self, stdscr):
        curses.curs_set(0)
        stdscr.keypad(True)
        stdscr.timeout(120)
        self.base_timeout = 120
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, -1, -1)
        curses.init_pair(2, 243, -1)
        curses.init_pair(3, 240, -1)
        curses.init_pair(4, 250, -1)
        curses.init_pair(5, ACCENT, -1)
        curses.init_pair(8, GREEN, -1)
        curses.init_pair(9, YELLOW, -1)
        curses.init_pair(10, RED, -1)
        curses.init_pair(12, 250, 236)   # SESSIONS 底色带
        curses.init_pair(13, 255, 236)   # 焦点行: 标题
        curses.init_pair(14, 240, 236)   # 焦点行: 时间/暗色
        curses.init_pair(15, ACCENT, 236)
        curses.init_pair(16, GREEN, 236)
        curses.init_pair(17, YELLOW, 236)
        curses.init_pair(18, RED, 236)
        curses.init_pair(26, 255, -1)    # 悬停行: 文字提亮
        try:
            curses.mouseinterval(0)   # 点击改用 PRESSED 上报, motion 即时生效
        except curses.error:
            pass
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS
                             | curses.REPORT_MOUSE_POSITION)
        except curses.error:
            pass
        # ncurses 经 terminfo 的鼠标编码在 tmux 下不转发悬停移动;
        # 直接开启 SGR 1003/1006, tmux 会把 motion 转发给本面板
        try:
            import sys as _sys
            _sys.stdout.write("\x1b[?1003;1006h")
            _sys.stdout.flush()
        except Exception:
            pass

        self.last_version = -1
        self.last_minute = -1
        self.last_frame = -1
        log(f"启动: pid={os.getpid()} session={SESSION}")
        while True:
            try:
                self.tick(stdscr)
            except Exception:
                import traceback
                log("tick 异常:\n" + traceback.format_exc())
                raise

    def main_pane_width(self) -> int:
        """tmux 里的 main-pane-width 选项值(布局的唯一事实源)"""
        r = tmux("show-window-option", "-v", "-t", f"{SESSION}:0",
                 "main-pane-width")
        try:
            return int(r.stdout.strip())
        except (ValueError, AttributeError, TypeError):
            return expanded_width()

    def layout_guard(self, stdscr):
        """布局守卫: main-pane-width 选项是唯一事实源。

        面板宽度 == 选项值 → 一切正常;
        面板宽度 != 选项值 →
          窗口正在缩放 → 交给 autofit/阈值逻辑, 不插手;
          窗口没动且宽度在 [12,40] → 用户在拖分隔条 → 采纳为新宽度;
          否则(被挤压/越界) → 重申布局纠正回选项值。"""
        if not self.ready:
            return
        H, W = stdscr.getmaxyx()
        opt = self.main_pane_width()
        if W == opt:
            return
        ww = window_width()
        if ww != self.last_ww:
            self.last_ww = ww
            self.ww_changed_at = time.time()
        now = time.time()
        recent_resize = now - self.ww_changed_at < 1.5
        if recent_resize:
            return                 # 缩放中的偏差归 autofit/阈值逻辑管
        if not self.rail and 12 <= W <= MAX_W:
            # 窗口没动而宽度变了 = 用户在拖分隔条 → 采纳并记忆
            tmux("set-window-option", "-t", f"{SESSION}:0",
                 "main-pane-width", str(W))
            if W != self.last_saved_w:
                self.last_saved_w = W
                save_expanded_width(W)
            return
        if now - self.last_fix < W_COOLDOWN:
            return
        self.last_fix = now
        tmux("set-window-option", "-t", f"{SESSION}:0",
             "main-pane-width", str(opt))
        tmux("select-layout", "-t", f"{SESSION}:0", "main-vertical")
        p = sidebar_pane_id()
        cw = tmux("display-message", "-p", "-t", p, '#{pane_width}')
        if cw and cw.stdout.strip() != str(opt):
            tmux("resize-pane", "-t", p, "-x", str(opt))


    def handle_escape(self, stdscr, items, row_idx):
        """解码 SGR 鼠标序列 \x1b[<b;x;yM/m (ncurses 不认, 需自制解析)。
        b: 0=左键按下 1=左键抬起 64/65=滚轮 32=悬停移动"""
        H, W = stdscr.getmaxyx()
        stdscr.timeout(40)              # 序列剩余字节的最大等待
        seq = [27]
        try:
            while len(seq) < 24:
                c = stdscr.getch()
                if c == -1:
                    break
                seq.append(c)
                if (c in (77, 109) and len(seq) >= 6
                        and seq[1] == 91 and seq[2] == 60):
                    break               # M/m = 序列终结
        finally:
            stdscr.timeout(self.base_timeout)
        if seq[1] != 91 or seq[2] != 60:
            return                      # 其他 ESC 序列: 忽略
        try:
            parts = "".join(chr(c) for c in seq[3:-1]).split(";")
            b, x, y = int(parts[0]), int(parts[1]), int(parts[2])
        except (ValueError, IndexError):
            return
        mx, my = x - 1, y - 1           # SGR 坐标从 1 起
        if b & 32 or b == 35:
            # 悬停移动(无按键)
            new_hover = None
            if self.rail:
                new_hover = ("rail",)
            elif my in self.row_at:
                new_hover = ("row", self.row_at[my])
            elif my == H - 1:
                if mx >= self.footer_btn_x - 1:
                    new_hover = ("collapse",)
                elif (self.exit_zone
                      and self.exit_zone[0] <= mx <= self.exit_zone[1]):
                    new_hover = ("exit",)
            self.last_motion = time.time()
            if new_hover != self.hover:
                self.hover = new_hover
                self.draw(stdscr)
            return
        if b in (64, 65):               # 滚轮
            if b == 64:
                self.offset = max(0, self.offset - 3)
            else:
                self.offset = min(max(0, len(items) - 1) if items else 0,
                                  self.offset + 3)
            self.draw(stdscr)
            return
        if b == 0:                      # 左键按下 → 点击
            self.last_motion = time.time()
            self.click(my, mx, H, items, row_idx)
            self.draw(stdscr)

    def tick(self, stdscr):
        try:
            self._tick(stdscr)
            self.consec_err = 0
        except SystemExit:
            raise
        except Exception:
            import traceback
            self.consec_err += 1
            log(f"tick 异常(连续 {self.consec_err} 次):\n"
                + traceback.format_exc())
            if self.consec_err > 30:
                raise
            # 记录后跳过本拍继续运行, 避免一次偶发错误杀死整个侧栏

    def _tick(self, stdscr):
        rows, live, ready, version = self.snapshot()
        items = self.display_items(rows)
        row_idx = [i for i, it in enumerate(items) if it[0] == "row"]
        now = time.time()
        now_ms = now * 1000
        minute = int(now // 60)
        working = any(s in ("busy", "working", "active", "running")
                      for s in live.values())
        frame = int(now_ms / 120) % len(SPINNER)
        if (version != self.last_version or minute != self.last_minute
                or (working and frame != self.last_frame)):
            self.draw(stdscr)
            self.last_version = version
            self.last_minute = minute
            self.last_frame = frame

        # claude 面板没了 → 工作区该结束,侧栏退场(启动后 10s 内宽限不判死)
        if now - self.last_pane_check > 5:
            self.last_pane_check = now
            if (now - self.started_at > 10
                    and not self.right_pane_alive()):
                log("宿主面板不存在, 侧栏退出")
                raise SystemExit(0)
        # 布局守卫: 面板宽度偏离目标 → 立即重申 main-vertical 布局
        self.layout_guard(stdscr)
        # 悬停过期清理(鼠标离开侧栏后不再有 motion 事件)
        if self.hover and now - self.last_motion > 2.0:
            self.hover = None
            self.draw(stdscr)

        ch = stdscr.getch()
        if ch == 27:
            # SGR 鼠标序列(悬停/点击/滚轮)由我们自己解码 — 对齐 fleet view
            self.handle_escape(stdscr, items, row_idx)
        elif ch == curses.KEY_RESIZE:
            stdscr.erase()
            self.draw(stdscr)
            self.layout_guard(stdscr)
        elif self.rail and ch not in (-1, curses.KEY_MOUSE):
            self.act(lambda: subprocess.run([TOGGLE]))   # rail 任意键 → 展开
            self.draw(stdscr)
        elif ch in (curses.KEY_DOWN, ord("j")):
            self.move(row_idx, 1)
            self.draw(stdscr)
        elif ch in (curses.KEY_UP, ord("k")):
            self.move(row_idx, -1)
            self.draw(stdscr)
        elif ch in (curses.KEY_ENTER, 10, 13):
            self.focus_visible = False      # 回车后撤掉灰底,直到下次方向键
            self.open_selected(items, row_idx)
            self.draw(stdscr)
        elif ch == curses.KEY_MOUSE:
            try:
                _, mx, my, _, bstate = curses.getmouse()
                H = stdscr.getmaxyx()[0]
                if bstate & (curses.BUTTON1_CLICKED
                             | curses.BUTTON1_PRESSED):
                    self.last_motion = time.time()
                    self.click(my, mx, H, items, row_idx)
                    self.draw(stdscr)
                elif bstate & curses.BUTTON4_PRESSED:
                    self.offset = max(0, self.offset - 3)
                    self.draw(stdscr)
                elif bstate & curses.BUTTON5_PRESSED:
                    self.offset = min(max(0, len(items) - 1),
                                      self.offset + 3)
                    self.draw(stdscr)
                elif bstate & curses.REPORT_MOUSE_POSITION:
                    # 鼠标悬停: 命中行/按钮变化时重画
                    self.last_motion = time.time()
                    new_hover = None
                    if self.rail:
                        new_hover = ("rail",)
                    elif my in self.row_at:
                        new_hover = ("row", self.row_at[my])
                    elif my == H - 1:
                        if mx >= self.footer_btn_x - 1:
                            new_hover = ("collapse",)
                        elif (self.exit_zone and
                              self.exit_zone[0] <= mx <= self.exit_zone[1]):
                            new_hover = ("exit",)
                    if new_hover != self.hover:
                        self.hover = new_hover
                        self.draw(stdscr)
            except curses.error:
                pass


def main():
    def _run(stdscr):
        App().run(stdscr)
    try:
        curses.wrapper(_run)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
