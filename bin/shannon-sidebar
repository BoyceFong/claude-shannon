def save_expanded_width(w: int) -> None:
    try:
        with open(os.path.join(STATE_DIR, "sidebar-w"), "w") as fh:
            fh.write(f"{w}\n")
    except OSError:
        pass


def load_ignored() -> set:
    """用户手动隐藏的会话 id(按 x)"""
    try:
        with open(os.path.join(STATE_DIR, "ignored.json")) as fh:
            v = json.load(fh)
        return set(v) if isinstance(v, list) else set()
    except (OSError, ValueError):
        return set()


def ignore_ids(ids) -> None:
    cur = load_ignored()
    try:
        with open(os.path.join(STATE_DIR, "ignored.json"), "w") as fh:
            json.dump(sorted(cur | set(ids)), fh)
    except OSError:
        pass


def expanded_width() -> int:
    """上次记忆的展开宽度,非法时回退配置值"""
    fallback = CFG["SIDEBAR_W"]
    try:
        with open(os.path.join(STATE_DIR, "sidebar-w")) as fh:
            v = fh.read().strip()
        if v.isdigit() and MIN_W_SAVE <= int(v) <= MAX_W:
            return int(v)
    except OSError:
        pass
    return fallback


def window_width() -> str:
    r = tmux("display-message", "-p", "-t", f"{SESSION}:0", "#{window_width}")
    return r.stdout.strip() if r else ""


def pid_alive(pid) -> bool:
    """agents --json 会留下已经死掉的 worker, 不能拿它们当"正在运行"。"""
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return True                         # 没给 pid: 无法证伪, 当作活着
    if pid <= 0:
        return True
    try:
        os.kill(pid, 0)
    except PermissionError:
        return True
    except OSError:
        return False
    return True


def live_status() -> dict:
    """{sessionId: {status, kind, state, pid}} — 来自 claude agents --json"""
    try:
        out = subprocess.run(
            ["claude", "agents", "--json"],
            capture_output=True, text=True, timeout=8,
        ).stdout
        arr = json.loads(out)
    except Exception:
        return {}
    live = {}
    for a in arr if isinstance(arr, list) else []:
        if not isinstance(a, dict):
            continue
        sid = a.get("sessionId") or a.get("id")
        if not sid:
            continue
        kind = str(a.get("kind") or "")
        pid = a.get("pid")
        if pid not in (None, "", 0) and not pid_alive(pid):
            continue
        # pid=null: agents 仍会列出这个后台会话(等待输入/已完成), 状态照常
        # 展示, 但它没有可接管的 job —— `claude attach` 会报 No job matching。
        attachable = bool(a.get("id")) and pid not in (None, "", 0)
        live[sid] = {"status": str(a.get("status") or ""),
                     "kind": kind,
                     "state": str(a.get("state") or ""),
                     "pid": pid,
                     # `claude attach` 只认 8 位短 id(或会话名), 不认完整 uuid
                     "short": str(a.get("id") or ""),
                     "attachable": attachable}
    return live


def status_glyph(row: dict, live: dict, current: bool) -> tuple:
    """(字符或 None=星形动画, 状态种类) — 逐项对齐 Claude Code fleet view:
    工作中=星形旋转(珊瑚) 等待输入=✱(黄) 完成/停止/历史=•(灰)
    右栏正在显示的会话=✽(珊瑚) 失败=✱(红)

    状态取自会话的代表 worker; 一个会话有多个 fork 时, 只要有活着的
    worker, 就用活得最"热"的那个的状态。"""
    if current:
        return ("✽", "accent")               # 右栏当前会话
    if row.get("starting"):
        return (None, "accent")              # 新建会话启动中
    info = live.get(row.get("live_id") or "")
    if info is None:
        for sid in row.get("ids", ()):        # live_id 刚失效时在族内兜底
            if sid in live:
                info = live[sid]
                break
    if info is None:
        return ("•", "dim")                  # 历史(未运行)
    status = (info.get("status") or "").lower()
    state = (info.get("state") or "").lower()
    if ("input" in status or "wait" in status
            or state in ("blocked", "waiting", "needs_input")):
        return ("✱", "yellow")               # 等待用户输入
    if (status in ("busy", "working", "active", "running")
            or state in ("working", "running")):
        return (None, "accent")              # 工作中(星形动画)
    if state in ("done", "completed") or status in ("done", "completed"):
        return ("•", "dim")                  # 完成
    if "fail" in status or "error" in status or state in ("failed", "error"):
        return ("✱", "red")                  # 失败
    return ("•", "dim")                      # 已停止/退出


KIND_PAIR = {"accent": 5, "green": 8, "yellow": 9, "red": 10,
             "dim": 3, "idle": 3}
# 焦点行(灰底 236)的同色系变体
CURSOR_BG = {"accent": 15, "green": 16, "yellow": 17, "red": 18,
             "dim": 14, "idle": 14}
# 悬停: 对齐 fleet view —— 文字提亮, 不加底色
HOVER_FG = {"accent": 5, "green": 8, "yellow": 9, "red": 10,
            "dim": 4, "idle": 4}


# ---------------------------------------------------------------- 操作

def tmux(*args):
    try:
        return subprocess.run(
            ["tmux", *args], capture_output=True, text=True, timeout=8)
    except Exception:
        return None


def activate(row):
    """点击某个会话: 右栏就地加载。

    会话身份优先用活着的 worker(attach, 不复制); 只有在没有活 worker
    时才 --resume 一个历史分段。--resume 默认复用原 session id,
    不加 --fork-session, 所以从这里打开会话永远不会再造出副本。"""
    pane = host_pane_id()
    if not pane:
        return "找不到宿主面板"
    if row["id"].startswith("ghost:"):
        return "会话启动中, 马上就好"
    if current_session_id() in row.get("ids", (row["id"],)):
        return "已经在这里了"
    bin_dir = os.path.dirname(os.path.abspath(__file__))
    live = live_status()
    # 族里所有活着的 worker, 最热的优先
    live_ids = [sid for sid in row.get("ids", ()) if sid in live]
    live_ids.sort(key=lambda sid: live_rank(live[sid]), reverse=True)
    name = os.path.basename(row["cwd"].rstrip("/")) or row["project"]
    if live_ids:
        target = live_ids[0]
        info = live[target]
        if info.get("kind") == "interactive":
            return "该会话正在其他终端运行"
        short = info.get("short") if info.get("attachable") else ""
        if short:
            # attach 用短 id(完整 uuid 匹配不到 job); 同时带上完整 id,
            # 万一接管失败, shannon-host 会退回 --resume 同一会话。
            r = tmux("respawn-pane", "-k", "-t", pane, "-c", row["cwd"],
                     "env", f"SHANNON_DIR={row['cwd']}",
                     f"SHANNON_ATTACH={short}",
                     f"SHANNON_RESUME={target}", f"{bin_dir}/shannon-host")
            if r is not None and r.returncode == 0:
                set_current_session(target)
                return f"已接管后台会话: {name}"
            return "接管失败"
    r = tmux("respawn-pane", "-k", "-t", pane, "-c", row["cwd"],
             "env", f"SHANNON_DIR={row['cwd']}",
             f"SHANNON_RESUME={row['id']}", f"{bin_dir}/shannon-host")
    if r is not None and r.returncode == 0:
        set_current_session(row["id"])
        return f"已切换到 {name}"
    return "切换失败"


# ---------------------------------------------------------------- 界面

class App:
    def __init__(self):
        self.lock = threading.Lock()
        self.rows = []
        self.live = {}
        self.ready = False
        self.version = 0
        self.stop = threading.Event()
        self.order = None            # 首次加载时冻结的排序基准(id → mtime)
        self.ghost = None            # 刚新建、transcript 尚未落盘的占位会话
        self.wake = threading.Event()
        threading.Thread(target=self.refresh_loop, daemon=True).start()

        self.sel = 0            # 焦点行在 display 行里的序号
        self.focus_visible = True
        self.offset = 0         # 滚动
        self.rail = False       # rail 模式(收窄成细条)
        self.picking = False    # 新建会话: 正在选择项目
        self.psel = 0           # picking 模式的焦点序号
        self.proj_list = []     # picking 模式的项目列表 [(cwd, name)]
        self.entry_mode = False  # 正在输入全新路径
        self.entry_buf = ""     # 路径输入缓冲
        self.hover = None       # ('row', idx) | ('collapse',) | ('exit',) | ('new',) | ('rail',)
        self.msg = ""
        self.msg_until = 0.0
        self.footer_btn_x = -1
        self.exit_zone = None   # ✕ 退出 的点击范围
        self.new_zone = None    # ＋ 新建 的点击范围
        self.cancel_zone = None  # 取消 的点击范围(picking)
        self.row_at = {}        # 屏幕行号 → display 行序号
        self.last_pane_check = 0.0
        self.started_at = time.time()
        self.consec_err = 0
        self.last_fix = 0.0
        self.last_act = 0.0     # 点击动作防抖
        self.last_motion = 0.0
        self.last_saved_w = 0
        self.last_ww = None     # 上次见到的窗口宽度
        self.ww_changed_at = 0.0  # 窗口宽度最后变化时刻(区分缩放/拖分隔条)

    def act(self, fn):
        """点击动作防抖: 180ms 内的重复事件忽略"""
        now = time.time()
        if now - self.last_act < 0.18:
            return
        self.last_act = now
        fn()

    def quit_session(self):
        tmux("kill-session", "-t", SESSION)

    # -- 后台刷新 -----------------------------------------------------
    def refresh_loop(self):
        while not self.stop.is_set():
            segments = scan_segments()
            live = live_status()
            rows = build_conversations(segments, live, load_ignored())
            ghost = self.ghost
            if ghost:
                # 新会话的 transcript 落盘后, 占位行功成身退
                real = any(r["cwd"] == ghost["cwd"]
                           and r["mtime"] >= ghost["mtime"] - 5000
                           for r in rows)
                if real or time.time() > (ghost["mtime"] + 300000) / 1000:
                    self.ghost = None
                else:
                    rows = [dict(ghost)] + [
                        r for r in rows if r["cwd"] != ghost["cwd"]]
            with self.lock:
                if self.order is None:
                    # 冻结初始排序: 之后点击/加载不再扰动顺序
                    self.order = {order_key(r): r["mtime"] for r in rows}
                order = dict(self.order)
            for r in rows:
                r["_k"] = order.get(order_key(r), r["mtime"])
            rows.sort(key=lambda r: r["_k"], reverse=True)
            with self.lock:
                self.rows = rows
                self.live = live
                self.ready = True
                self.version += 1
            if self.wake.wait(REFRESH_SECS):
                self.wake.clear()

    def snapshot(self):
        with self.lock:
            return self.rows, self.live, self.ready, self.version

    # -- 展示模型 -----------------------------------------------------
    def display_items(self, rows):
        """[('group', name) | ('row', row)] — 分组、限量(顺序沿用 rows)

        分组身份用完整 cwd, 显示名才用 basename: ~/work/app 和
        ~/personal/app 是两个项目, 不能因为同名就合并。"""
        groups = {}
        for r in rows:
            key = r["cwd"] or r["project"]
            name = (os.path.basename(r["cwd"].rstrip("/")) or r["project"]
                    if r["cwd"] else r["project"])
            groups.setdefault(key, {"name": name, "rows": []})["rows"].append(r)
        items = []
        gs = sorted(groups.values(),
                    key=lambda g: max(x["_k"] for x in g["rows"]),
                    reverse=True)
        for g in gs[:MAX_GROUPS]:
            items.append(("group", g["name"]))
            for r in g["rows"][:PER_GROUP]:
                items.append(("row", r))
        return items

    # -- 绘制 ---------------------------------------------------------
    def draw(self, stdscr):
        try:
            self._draw(stdscr)
        except curses.error:
            pass          # 窗口极小时的角落写入报错,忽略即可

    def _draw(self, stdscr):
        rows, live, ready, _ = self.snapshot()
        now_ms = time.time() * 1000
        H, W = stdscr.getmaxyx()

        # rail 模式: 侧栏被收窄成细条,底部保留展开按钮
        if W <= CFG["RAIL_W"] + 2:
            self.rail = True
            stdscr.erase()
            gx = max(0, min(1, W - 2))
            if self.hover == ("rail",):
                stdscr.addnstr(H - 1, gx, "▶", 1, curses.color_pair(26)
                               | curses.A_BOLD)
            else:
                stdscr.addnstr(H - 1, gx, "▶", 1,
                               curses.color_pair(5) | curses.A_BOLD)
            stdscr.refresh()
            return
        self.rail = False

        items = self.display_items(rows)
        row_idx = [i for i, it in enumerate(items) if it[0] == "row"]
        self.sel = max(0, min(self.sel, len(row_idx) - 1))
        view_rows = max(1, H - 2)
        cur = current_session_id()

        # 滚动: 焦点行保持可见
        if row_idx and self.focus_visible:
            sel_item = row_idx[self.sel]
            if sel_item < self.offset:
                self.offset = sel_item
            while (sel_item >= self.offset + view_rows
                   and self.offset < len(items)):
                self.offset += 1

        stdscr.erase()
        self.row_at = {}

        # 头部: SESSIONS 带灰色底带,与项目名明确区分
        band = curses.color_pair(12) | curses.A_BOLD
        stdscr.addnstr(0, 1, "SESSIONS", W - 2, band)
        if W > 9:
            stdscr.addnstr(0, 9, " " * (W - 9), W - 9, band)
        if row_idx:
            cnt = str(len(row_idx))
            stdscr.addnstr(0, max(2, W - 1 - cell_len(cnt)), cnt, W - 2, band)

        # 列表
        y = 1
        for i in range(self.offset, len(items)):
            if y > H - 2:
                break
            kind, payload = items[i]
            if kind == "group":
                stdscr.addnstr(y, 1, payload, W - 2,
                               curses.color_pair(2) | curses.A_BOLD)
            else:
                row = payload
                cursor = (self.focus_visible
                          and self.sel < len(row_idx)
                          and row_idx[self.sel] == i)
                hovered = self.hover == ("row", i)
                current = bool(cur) and cur in row.get("ids", (row["id"],))
                t = ago(row["mtime"], now_ms)
                gch, gkind = status_glyph(row, live, current)
                room = max(6, W - cell_len(t) - 6)
                title = trunc(row["title"], room)
                if gch is None:   # 工作中 → 菊花当前帧
                    gch = SPINNER[int(now_ms / 120) % len(SPINNER)]
                if cursor:
                    a_title = curses.color_pair(13)
                    a_time = curses.color_pair(14)
                    a_glyph = curses.color_pair(CURSOR_BG.get(gkind, 14))
                elif hovered:
                    a_title = curses.color_pair(26)   # 悬停: 文字提亮
                    a_time = curses.color_pair(4)
                    a_glyph = curses.color_pair(
                        HOVER_FG.get(gkind, 4))
                else:
                    a_title = curses.color_pair(1)
                    a_time = curses.color_pair(3)
                    a_glyph = curses.color_pair(KIND_PAIR.get(gkind, 3))
                if current:
                    # 珊瑚竖条 + 珊瑚标题 = 右栏正在显示的会话(不随键盘焦点移动)
                    a_title = curses.color_pair(
                        15 if cursor else (22 if hovered else 5))
                    stdscr.addnstr(y, 1, "▌", 1,
                                   curses.color_pair(
                                       15 if cursor else (22 if hovered
                                                          else 5)))
                stdscr.addnstr(y, 2, title, W - 2, a_title)
                x_time = W - 2 - cell_len(gch) - 1 - cell_len(t)
                stdscr.addnstr(y, max(2, x_time), t, W - 2, a_time)
                stdscr.addnstr(y, W - 2, gch, 1, a_glyph)
                self.row_at[y] = i
            y += 1

        if not ready:
            stdscr.addnstr(1, 1, "loading…", W - 2, curses.color_pair(3))
        elif not rows:
            stdscr.addnstr(1, 1, "no conversations yet", W - 2,
                           curses.color_pair(3))

        # 底部: "✕ 退出 · ＋ 新建"(左, 可点击) + "◀ 收起"(右, 可点击)
        btn = "◀ 收起"
        self.footer_btn_x = max(1, W - 1 - cell_len(btn))
        self.exit_zone = (1, cell_len("✕ 退出"))
        self.new_zone = (1 + cell_len("✕ 退出 · "), cell_len("✕ 退出 · ＋ 新建"))
        hover_exit = self.hover == ("exit",)
        hover_new = self.hover == ("new",)
        stdscr.addnstr(H - 1, 1, "✕ 退出", W - 2,
                       curses.color_pair(26 if hover_exit else 3))
        stdscr.addnstr(H - 1, 7, " · ", W - 7, curses.color_pair(3))
        stdscr.addnstr(H - 1, 10, "＋ 新建", W - 10,
                       curses.color_pair(26 if hover_new else 3))
        if self.hover == ("collapse",):
            stdscr.addnstr(H - 1, self.footer_btn_x, "◀", 1,
                           curses.color_pair(5) | curses.A_BOLD)
            stdscr.addnstr(H - 1, self.footer_btn_x + 1, " 收起",
                           W - self.footer_btn_x - 1, curses.color_pair(26))
        else:
            stdscr.addnstr(H - 1, self.footer_btn_x, "◀", 1,
                           curses.color_pair(5))
            stdscr.addnstr(H - 1, self.footer_btn_x + 1, " 收起",
                           W - self.footer_btn_x - 1, curses.color_pair(3))

        stdscr.refresh()

    def toast(self, m):
        self.msg = m
        self.msg_until = time.time() + 2.5
        self.last_version = -1          # 立即重画,让 toast 马上可见

    # -- 交互 ---------------------------------------------------------
    def move(self, row_idx, delta):
        if not row_idx:
            return
        self.focus_visible = True       # 上下键从当前焦点出发重新显示高亮
        self.sel = max(0, min(len(row_idx) - 1, self.sel + delta))

    def open_selected(self, items, row_idx):
        if not row_idx or self.sel >= len(row_idx):
            return
        self.toast(activate(items[row_idx[self.sel]][1]))

    def click(self, my, mx, H, items, row_idx):
        if self.rail:
            self.act(lambda: subprocess.run([TOGGLE]))   # rail 点击 → 展开
            return
        if my == H - 1:
            # 底部按钮区: ✕ 退出 · ＋ 新建 · ◀ 收起(命中区放宽一格)
            if (self.exit_zone and self.exit_zone[0] <= mx <= self.exit_zone[1]):
                self.act(self.quit_session)
            elif (self.new_zone and self.new_zone[0] <= mx <= self.new_zone[1]):
                self.picking = True
                self.psel = 0
            elif mx >= self.footer_btn_x - 1:
                self.act(lambda: subprocess.run([TOGGLE]))
            return
        if my in self.row_at:
            idx = self.row_at[my]
            if idx < len(items) and items[idx][0] == "row":
                def open_row():
                    if idx in row_idx:
                        self.sel = row_idx.index(idx)   # 焦点跟随点击行
                    self.toast(activate(items[idx][1]))
                self.act(open_row)

    def right_pane_alive(self):
        pane = host_pane_id()
        if not pane:
            return True
        r = tmux("list-panes", "-t", f"{SESSION}:0", "-F", "#{pane_id}")
        ids = (r.stdout or "").split() if r else []
        alive = r is None or pane in ids
        if not alive:
            log(f"宿主面板消失判定: host-pane={pane} list-panes={ids} "
                f"rc={r.returncode if r else 'exc'}")
        return alive

    def run(self, stdscr):
        curses.curs_set(0)
        stdscr.keypad(True)
        stdscr.timeout(120)
        self.base_timeout = 120
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, -1, -1)
        curses.init_pair(2, 243, -1)
        curses.init_pair(3, 240, -1)
        curses.init_pair(4, 250, -1)
        curses.init_pair(5, ACCENT, -1)
        curses.init_pair(8, GREEN, -1)
        curses.init_pair(9, YELLOW, -1)
        curses.init_pair(10, RED, -1)
        curses.init_pair(12, 250, 236)   # SESSIONS 底色带
        curses.init_pair(13, 255, 236)   # 焦点行: 标题
        curses.init_pair(14, 240, 236)   # 焦点行: 时间/暗色
        curses.init_pair(15, ACCENT, 236)
        curses.init_pair(16, GREEN, 236)
        curses.init_pair(17, YELLOW, 236)
        curses.init_pair(18, RED, 236)
        curses.init_pair(26, 255, -1)    # 悬停行: 文字提亮
        try:
            curses.mouseinterval(0)   # 点击改用 PRESSED 上报, motion 即时生效
        except curses.error:
            pass
        try:
            curses.mousemask(curses.ALL_MOUSE_EVENTS
                             | curses.REPORT_MOUSE_POSITION)
        except curses.error:
            pass
        # ncurses 经 terminfo 的鼠标编码在 tmux 下不转发悬停移动;
        # 直接开启 SGR 1003/1006, tmux 会把 motion 转发给本面板
        try:
            import sys as _sys
            _sys.stdout.write("\x1b[?1003;1006h")
            _sys.stdout.flush()
        except Exception:
            pass

        self.last_version = -1
        self.last_minute = -1
        self.last_frame = -1
        log(f"启动: pid={os.getpid()} session={SESSION}")
        while True:
            try:
                self.tick(stdscr)
            except Exception:
                import traceback
                log("tick 异常:\n" + traceback.format_exc())
                raise

    def main_pane_width(self) -> int:
        """tmux 里的 main-pane-width 选项值(布局的唯一事实源)"""
        r = tmux("show-window-option", "-v", "-t", f"{SESSION}:0",
                 "main-pane-width")
        try:
            return int(r.stdout.strip())
        except (ValueError, AttributeError, TypeError):
            return expanded_width()

    def layout_guard(self, stdscr):
        """布局守卫: main-pane-width 选项是唯一事实源。

        面板宽度 == 选项值 → 一切正常;
        面板宽度 != 选项值 →
          窗口正在缩放 → 交给 autofit/阈值逻辑, 不插手;
          窗口没动且宽度在 [12,40] → 用户在拖分隔条 → 采纳为新宽度;
          否则(被挤压/越界) → 重申布局纠正回选项值。"""
        if not self.ready:
            return
        H, W = stdscr.getmaxyx()
        opt = self.main_pane_width()
        if W == opt:
            return
        ww = window_width()
        if ww != self.last_ww:
            self.last_ww = ww
            self.ww_changed_at = time.time()
        now = time.time()
        recent_resize = now - self.ww_changed_at < 1.5
        if recent_resize:
            return                 # 缩放中的偏差归 autofit/阈值逻辑管
        if not self.rail and 12 <= W <= MAX_W:
            # 窗口没动而宽度变了 = 用户在拖分隔条 → 采纳并记忆
            tmux("set-window-option", "-t", f"{SESSION}:0",
                 "main-pane-width", str(W))
            if W != self.last_saved_w:
                self.last_saved_w = W
                save_expanded_width(W)
            return
        if now - self.last_fix < W_COOLDOWN:
            return
        self.last_fix = now
        tmux("set-window-option", "-t", f"{SESSION}:0",
             "main-pane-width", str(opt))
        tmux("select-layout", "-t", f"{SESSION}:0", "main-vertical")
        p = sidebar_pane_id()
        cw = tmux("display-message", "-p", "-t", p, '#{pane_width}')
        if cw and cw.stdout.strip() != str(opt):
            tmux("resize-pane", "-t", p, "-x", str(opt))


    def handle_escape(self, stdscr, items, row_idx):
        """解码 SGR 鼠标序列 \x1b[<b;x;yM/m (ncurses 不认, 需自制解析)。
        b: 0=左键按下 1=左键抬起 64/65=滚轮 32=悬停移动
        返回 True 表示这是一个"裸 ESC"(未组成鼠标序列)。"""
        H, W = stdscr.getmaxyx()
        stdscr.timeout(40)              # 序列剩余字节的最大等待
        seq = [27]
        try:
            while len(seq) < 24:
                c = stdscr.getch()
                if c == -1:
                    break
                seq.append(c)
                if (c in (77, 109) and len(seq) >= 6
                        and seq[1] == 91 and seq[2] == 60):
                    break               # M/m = 序列终结
        finally:
            stdscr.timeout(self.base_timeout)
        if seq[1] != 91 or seq[2] != 60:
            return True                 # 裸 ESC: 交回调用方(取消 picking 等)
        try:
            parts = "".join(chr(c) for c in seq[3:-1]).split(";")
            b, x, y = int(parts[0]), int(parts[1]), int(parts[2])
        except (ValueError, IndexError):
            return False
        mx, my = x - 1, y - 1           # SGR 坐标从 1 起
        if b & 32 or b == 35:
            # 悬停移动(无按键)
            new_hover = None
            if self.rail:
                new_hover = ("rail",)
            elif my in self.row_at:
                new_hover = ("row", self.row_at[my])
            elif my == H - 1:
                if mx >= self.footer_btn_x - 1:
                    new_hover = ("collapse",)
                elif (self.exit_zone
                      and self.exit_zone[0] <= mx <= self.exit_zone[1]):
                    new_hover = ("exit",)
                elif (self.new_zone
                      and self.new_zone[0] <= mx <= self.new_zone[1]):
                    new_hover = ("new",)
            self.last_motion = time.time()
            if new_hover != self.hover:
                self.hover = new_hover
                self.draw(stdscr)
            return False
        if b in (64, 65):               # 滚轮
            if b == 64:
                self.offset = max(0, self.offset - 3)
            else:
                self.offset = min(max(0, len(items) - 1) if items else 0,
                                  self.offset + 3)
            self.draw(stdscr)
            return False
        if b == 0:                      # 左键按下 → 点击
            self.last_motion = time.time()
            self.click(my, mx, H, items, row_idx)
            self.draw(stdscr)
        return False

    def project_list(self, rows):
        """picking 列表: 去重后的项目 (cwd, name), 按活跃度排序"""
        out = []
        seen = set()
        for r in rows:
            cwd = r.get("cwd")
            if cwd and cwd not in seen:
                seen.add(cwd)
                name = os.path.basename(cwd.rstrip("/")) or r.get("project", cwd)
                out.append((cwd, name))
        return out

    def draw_picking(self, stdscr):
        try:
            self._draw_picking(stdscr)
        except curses.error:
            pass

    def _draw_picking(self, stdscr):
        rows, _, _, _ = self.snapshot()
        H, W = stdscr.getmaxyx()
        self.proj_list = self.project_list(rows)
        n = len(self.proj_list) + 1      # 顶部多一个"输入新路径"入口
        self.psel = max(0, min(self.psel, n - 1))
        stdscr.erase()
        band = curses.color_pair(12) | curses.A_BOLD
        stdscr.addnstr(0, 1, "NEW SESSION → 选择项目", W - 2, band)
        if W > 9:
            stdscr.addnstr(0, 9, " " * (W - 9), W - 9, band)
        y = 1
        sel0 = self.psel == 0
        if sel0:
            stdscr.addnstr(y, 1, " " * (W - 2), W - 2,
                           curses.color_pair(13))
            stdscr.addnstr(y, 1, "▌", 1, curses.color_pair(15))
        stdscr.addnstr(y, 2, "✎ 输入新路径…", W - 2,
                       curses.color_pair(13 if sel0 else 26))
        self.row_at[y] = -1              # -1 = 输入新路径入口
        y += 1
        for i, (cwd, name) in enumerate(self.proj_list):
            if y > H - 2:
                break
            sel = self.psel == i + 1
            if sel:
                stdscr.addnstr(y, 1, " " * (W - 2), W - 2,
                               curses.color_pair(13))
                stdscr.addnstr(y, 1, "▌", 1, curses.color_pair(15))
            stdscr.addnstr(y, 2, trunc(name, W - 4), W - 2,
                           curses.color_pair(13 if sel else 1))
            self.row_at[y] = i + 1
            y += 1
        self.cancel_zone = (1, cell_len("取消"))
        stdscr.addnstr(H - 1, 1, "取消", W - 2,
                       curses.color_pair(26 if self.hover == ("cancel",)
                                         else 3))
        stdscr.addnstr(H - 1, 6, "· Enter 新建", W - 5,
                       curses.color_pair(3))
        stdscr.refresh()

    def tick_picking(self, stdscr):
        self.draw_picking(stdscr)
        ch = stdscr.getch()
        if ch == 27:
            if self.handle_escape(stdscr, [], []):
                self.picking = False
                self.draw(stdscr)
            return
        n = len(self.proj_list) + 1      # 含顶部"输入新路径"入口
        self.psel = max(0, min(self.psel, n - 1))
        if ch in (curses.KEY_DOWN, ord("j")):
            self.psel = min(self.psel + 1, n - 1)
        elif ch in (curses.KEY_UP, ord("k")):
            self.psel = max(0, self.psel - 1)
        elif ch in (curses.KEY_ENTER, 10, 13):
            if self.psel == 0:
                self.entry_mode = True   # 输入新路径
            elif self.psel - 1 < len(self.proj_list):
                cwd = self.proj_list[self.psel - 1][0]
                self.picking = False
                self.toast(self.new_session(cwd))
                self.draw(stdscr)
            return
        elif ch == curses.KEY_MOUSE:
            try:
                _, mx, my, _, bstate = curses.getmouse()
                if bstate & (curses.BUTTON1_CLICKED
                             | curses.BUTTON1_PRESSED):
                    if my == H - 1 and (self.cancel_zone and
                                        self.cancel_zone[0] <= mx <=
                                        self.cancel_zone[1] + 1):
                        self.picking = False   # 点击"取消" → 关闭选择器
                    elif my in self.row_at:
                        idx = self.row_at[my]
                        if idx == -1:
                            self.entry_mode = True
                        elif idx < len(self.proj_list):
                            cwd = self.proj_list[idx][0]
                            self.picking = False
                            self.toast(self.new_session(cwd))
                            self.draw(stdscr)
            except curses.error:
                pass

    def draw_entry(self, stdscr):
        try:
            self._draw_entry(stdscr)
        except curses.error:
            pass

    def _draw_entry(self, stdscr):
        H, W = stdscr.getmaxyx()
        stdscr.erase()
        band = curses.color_pair(12) | curses.A_BOLD
        stdscr.addnstr(0, 1, "NEW SESSION → 输入路径", W - 2, band)
        if W > 9:
            stdscr.addnstr(0, 9, " " * (W - 9), W - 9, band)
        shown = trunc(self.entry_buf, max(1, W - 6))
        stdscr.addnstr(2, 1, "> ", W - 2, curses.color_pair(3))
        stdscr.addnstr(2, 3, shown, W - 3, curses.color_pair(26))
        stdscr.addnstr(2, 3 + cell_len(shown) + 1, "▌", 1,
                       curses.color_pair(5))
        hint = "Enter 确认(目录不存在会自动创建) · Esc 取消"
        stdscr.addnstr(H - 1, 1, trunc(hint, W - 2), W - 2,
                       curses.color_pair(3))
        stdscr.refresh()

    def tick_entry(self, stdscr):
        self.draw_entry(stdscr)
        try:
            ch = stdscr.get_wch()
        except curses.error:
            return          # get_wch 在 timeout 无输入时抛错, 跳过本拍
        if ch == 27:
            # 裸 ESC → 回到 picking; 鼠标序列在输入态忽略
            stdscr.timeout(40)
            c2 = stdscr.getch()
            stdscr.timeout(self.base_timeout)
            if c2 == -1:
                self.entry_mode = False
                self.draw_picking(stdscr)
            return
        if ch in (curses.KEY_ENTER, 10, 13):
            path = os.path.expanduser(self.entry_buf.strip())
            if path.startswith("/") and os.path.basename(path):
                try:
                    os.makedirs(path, exist_ok=True)
                except OSError as e:
                    self.toast(f"无法创建目录: {e.strerror}")
                    self.draw(stdscr)
                    return
                self.entry_mode = False
                self.picking = False
                self.toast(self.new_session(path))
                self.draw(stdscr)
            else:
                self.toast("需要绝对路径, 如 ~/code/new-project")
            return
        if ch in (curses.KEY_BACKSPACE, 127, 8):
            self.entry_buf = self.entry_buf[:-1]
            self.draw_entry(stdscr)
        elif isinstance(ch, str) and ch.isprintable():
            self.entry_buf += ch
            self.draw_entry(stdscr)

    def new_session(self, cwd):
        """在指定项目目录新建一个全新会话(右栏就地加载空白 claude)"""
        pane = host_pane_id()
        if not pane:
            return "找不到宿主面板"
        bin_dir = os.path.dirname(os.path.abspath(__file__))
        r = tmux("respawn-pane", "-k", "-t", pane, "-c", cwd,
                 "env", f"SHANNON_DIR={cwd}", "SHANNON_START=blank",
                 f"{bin_dir}/shannon-host")
        if r is not None and r.returncode == 0:
            set_current_session("")
            name = os.path.basename(cwd.rstrip("/")) or cwd
            gid = f"ghost:{cwd}"
            self.ghost = {
                "id": gid,
                "live_id": "",
                "ids": [gid],
                "root": "",
                "cwd": cwd,
                "project": name,
                "title": f"新会话 · {name}",
                "mtime": time.time() * 1000,
                "has_messages": True,
                "starting": True,
            }
            self.wake.set()          # 立即刷新, 新会话马上出现在列表里
            return f"新会话已创建: {name}"
        return "创建失败"

    def tick(self, stdscr):
        try:
            self._tick(stdscr)
            self.consec_err = 0
        except SystemExit:
            raise
        except Exception:
            import traceback
            self.consec_err += 1
            log(f"tick 异常(连续 {self.consec_err} 次):\n"
                + traceback.format_exc())
            if self.consec_err > 30:
                raise
            # 记录后跳过本拍继续运行, 避免一次偶发错误杀死整个侧栏

    def _tick(self, stdscr):
        if self.entry_mode:
            self.tick_entry(stdscr)
            return
        if self.picking:
            self.tick_picking(stdscr)
            return
        rows, live, ready, version = self.snapshot()
        items = self.display_items(rows)
        row_idx = [i for i, it in enumerate(items) if it[0] == "row"]
        now = time.time()
        now_ms = now * 1000
        minute = int(now // 60)
        working = any(isinstance(v, dict)
                      and (v.get("status") or "").lower()
                      in ("busy", "working", "active", "running")
                      for v in live.values())
        frame = int(now_ms / 120) % len(SPINNER)
        if (version != self.last_version or minute != self.last_minute
                or (working and frame != self.last_frame)):
            self.draw(stdscr)
            self.last_version = version
            self.last_minute = minute
            self.last_frame = frame

        # claude 面板没了 → 工作区该结束,侧栏退场(启动后 10s 内宽限不判死)
        if now - self.last_pane_check > 5:
            self.last_pane_check = now
            if (now - self.started_at > 10
                    and not self.right_pane_alive()):
                log("宿主面板不存在, 侧栏退出")
                raise SystemExit(0)
        # 布局守卫: 面板宽度偏离目标 → 立即重申 main-vertical 布局
        self.layout_guard(stdscr)
        # 悬停过期清理(鼠标离开侧栏后不再有 motion 事件)
        if self.hover and now - self.last_motion > 2.0:
            self.hover = None
            self.draw(stdscr)

        ch = stdscr.getch()
        if ch == 27:
            # SGR 鼠标序列(悬停/点击/滚轮)由我们自己解码 — 对齐 fleet view;
            # 裸 ESC = 取消 picking
            plain = self.handle_escape(stdscr, items, row_idx)
            if plain and self.picking:
                self.picking = False
                self.draw(stdscr)
        elif ch == curses.KEY_RESIZE:
            stdscr.erase()
            self.draw(stdscr)
            self.layout_guard(stdscr)
        elif self.rail and ch not in (-1, curses.KEY_MOUSE):
            self.act(lambda: subprocess.run([TOGGLE]))   # rail 任意键 → 展开
            self.draw(stdscr)
        elif ch in (curses.KEY_DOWN, ord("j")):
            self.move(row_idx, 1)
            self.draw(stdscr)
        elif ch in (curses.KEY_UP, ord("k")):
            self.move(row_idx, -1)
            self.draw(stdscr)
        elif ch in (ord("x"), curses.KEY_DC):
            # 隐藏焦点会话(数据不动, 只是不再显示)
            if row_idx and self.sel < len(row_idx):
                row = items[row_idx[self.sel]][1]
                if not row["id"].startswith("ghost:"):
                    # 隐藏整个会话族(而不只是当前分段), 否则 fork 会重新冒出来
                    ids = list(row.get("ids") or [row["id"]])
                    if row.get("root"):
                        ids.append(f"root:{row['root']}")
                    ignore_ids(ids)
                    self.wake.set()
                    self.toast("已隐藏该会话")
            self.draw(stdscr)
        elif ch == curses.KEY_MOUSE:
            try:
                _, mx, my, _, bstate = curses.getmouse()
                H = stdscr.getmaxyx()[0]
                if bstate & (curses.BUTTON1_CLICKED
                             | curses.BUTTON1_PRESSED):
                    self.last_motion = time.time()
                    self.click(my, mx, H, items, row_idx)
                    self.draw(stdscr)
                elif bstate & curses.BUTTON4_PRESSED:
                    self.offset = max(0, self.offset - 3)
                    self.draw(stdscr)
                elif bstate & curses.BUTTON5_PRESSED:
                    self.offset = min(max(0, len(items) - 1),
                                      self.offset + 3)
                    self.draw(stdscr)
                elif bstate & curses.REPORT_MOUSE_POSITION:
                    # 鼠标悬停: 命中行/按钮变化时重画
                    self.last_motion = time.time()
                    new_hover = None
                    if self.rail:
                        new_hover = ("rail",)
                    elif my in self.row_at:
                        new_hover = ("row", self.row_at[my])
                    elif my == H - 1:
                        if mx >= self.footer_btn_x - 1:
                            new_hover = ("collapse",)
                        elif (self.exit_zone and
                              self.exit_zone[0] <= mx <= self.exit_zone[1]):
                            new_hover = ("exit",)
                        elif (self.new_zone and
                              self.new_zone[0] <= mx <= self.new_zone[1]):
                            new_hover = ("new",)
                    if new_hover != self.hover:
                        self.hover = new_hover
                        self.draw(stdscr)
            except curses.error:
                pass


def dump():
    """调试视图: 打印折叠后的会话(不启动 curses)。"""
    segments = scan_segments()
    live = live_status()
    rows = build_conversations(segments, live, load_ignored())
    rows.sort(key=lambda r: r["mtime"], reverse=True)
    now_ms = time.time() * 1000
    for r in rows:
        print(f'{r["id"][:8]} {ago(r["mtime"], now_ms):>4} '
              f'live={r["live_id"][:8] or "-":8} ids={len(r["ids"])} '
              f'cwd={r["cwd"] or "-"} | {r["title"]}')
    print(f"-- {len(segments)} segments -> {len(rows)} conversations")


def main():
    def _run(stdscr):
        App().run(stdscr)
    try:
        curses.wrapper(_run)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    if "--dump" in sys.argv:
        dump()
    else:
        main()
