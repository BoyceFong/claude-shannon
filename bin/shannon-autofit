#!/bin/sh
# shannon-autofit — tmux client-resized 钩子, 阈值守门:
#   窗口宽 < COLLAPSE_AT   → main-pane-width = RAIL_W (rail)
#   窗口宽 >= COLLAPSE_AT  → main-pane-width = EXPAND_W (记忆宽度)
# 平时的窗口拖动不需要本脚本动手: main-vertical 布局下 tmux 自己保持
# 侧栏宽度恒定, 只有跨过阈值时才切换 main-pane-width。
# mode=manual(用户手动折叠)时, 拓宽窗口也不会自动展开。

BIN_DIR=$(cd "$(dirname "$0")" && pwd)
SESS="${SHANNON_SESSION:-shannon}"
# 与 shannon-workspace 保持同一套状态目录规则
if [ "$SESS" = "shannon" ]; then
  STATE_DIR="$HOME/.claude/shannon"
else
  SAFE_SESS=$(printf '%s' "$SESS" | tr -c 'A-Za-z0-9_-' '_')
  STATE_DIR="$HOME/.claude/shannon/sessions/$SAFE_SESS"
fi
# config 用逐行解析而不是 source: 状态文件里即使混进 shell 代码也不会被执行
cfg() { # cfg KEY DEFAULT
  v=$(awk -F= -v k="$1" '$1==k && $2 ~ /^[0-9]+$/ {v=$2} END {print v}' \
      "$STATE_DIR/config" 2>/dev/null)
  printf '%s\n' "${v:-$2}"
}
SIDEBAR_W=$(cfg SIDEBAR_W 35)
RAIL_W=$(cfg RAIL_W 2)
COLLAPSE_AT=$(cfg COLLAPSE_AT 70)

# 展开宽度 = 用户记忆值, 限制在 [12, 35]
EXPAND_W=$(cat "$STATE_DIR/sidebar-w" 2>/dev/null || true)
case "$EXPAND_W" in ''|*[!0-9]*) EXPAND_W=$SIDEBAR_W ;; esac
[ "$EXPAND_W" -ge 12 ] 2>/dev/null || EXPAND_W=$SIDEBAR_W
[ "$EXPAND_W" -le 40 ] 2>/dev/null || EXPAND_W=35

HOST_PANE=$(cat "$STATE_DIR/host-pane" 2>/dev/null)
[ -n "$HOST_PANE" ] || exit 0
SB=$(cat "$STATE_DIR/sidebar-pane" 2>/dev/null)
# 记录可能指向已经死掉的面板: 只有 tmux 里真实存在才算数
if [ -n "$SB" ]; then
  tmux list-panes -s -t "$SESS" -F '#{pane_id}' 2>/dev/null \
    | grep -qx "$SB" || SB=
fi
MODE=$(cat "$STATE_DIR/mode" 2>/dev/null)

# 窗口宽度(attached 时等于 client 宽度; detached 也可用, 便于测试)
W=$(tmux display-message -p -t "$SESS:0" '#{window_width}' 2>/dev/null)
[ -n "$W" ] || exit 0

pane_w() { tmux display-message -p -t "$SB" '#{pane_width}' 2>/dev/null; }

apply() { # $1 = 目标宽度, $2 = mode
  tmux set-window-option -t "$SESS:0" main-pane-width "$1" 2>/dev/null
  tmux select-layout -t "$SESS:0" main-vertical 2>/dev/null
  CW2=$(pane_w)
  if [ "$CW2" != "$1" ]; then
    tmux resize-pane -t "$SB" -x "$1" 2>/dev/null
  fi
  echo "$2" > "$STATE_DIR/mode"
}

# 侧栏面板不存在: 宽度足够且非手动折叠 → 重新切出
if [ -z "$SB" ]; then
  if [ "$W" -ge "$COLLAPSE_AT" ] && [ "$MODE" != "manual" ]; then
    NEW_SB=$(tmux split-window -h -b -l "$EXPAND_W" -t "$HOST_PANE" \
      -P -F '#{pane_id}' -c "$HOME" "$BIN_DIR/shannon-sidebar" 2>/dev/null)
    if [ -n "$NEW_SB" ]; then
      printf '%s\n' "$NEW_SB" > "$STATE_DIR/sidebar-pane"   # 否则 toggle 指向死面板
      echo auto > "$STATE_DIR/mode"
    fi
  fi
  exit 0
fi

CW=$(pane_w)
[ -n "$CW" ] || exit 0

if [ "$W" -lt "$COLLAPSE_AT" ]; then
  case "$CW" in [1-9]) exit 0 ;; esac   # 已是 rail
  apply "$RAIL_W" auto-collapsed
else
  if [ "$MODE" = "manual" ]; then
    case "$CW" in [1-9]) exit 0 ;; esac   # 用户手动折叠, 尊重
  fi
  [ "$CW" = "$EXPAND_W" ] && exit 0       # 已是目标宽度
  apply "$EXPAND_W" auto
fi
