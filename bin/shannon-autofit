#!/bin/sh
# shannon-autofit — tmux client-resized 钩子,布局强制器:
#   窗口宽 < COLLAPSE_AT      → 侧栏钉在 RAIL_W(rail)
#   窗口宽 >= COLLAPSE_AT     → 侧栏钉在 EXPAND_W(记忆宽度)
# tmux 在窗口变化时按比例重排各面板,本脚本随后把侧栏纠正回目标宽度,
# 拖动过程中侧栏宽度因此保持恒定,变的只有右栏。
# mode=manual(用户手动折叠)时,拓宽窗口也不会自动展开。

BIN_DIR=$(cd "$(dirname "$0")" && pwd)
STATE_DIR="$HOME/.claude/shannon"
SESS="${SHANNON_SESSION:-shannon}"
. "$STATE_DIR/config" 2>/dev/null || true
SIDEBAR_W=${SIDEBAR_W:-35}
RAIL_W=${RAIL_W:-2}
COLLAPSE_AT=${COLLAPSE_AT:-70}

# 展开宽度 = 用户记忆值, 限制在 [12, 35]
EXPAND_W=$(cat "$STATE_DIR/sidebar-w" 2>/dev/null)
case "$EXPAND_W" in ''|*[!0-9]*) EXPAND_W=$SIDEBAR_W ;; esac
[ "$EXPAND_W" -ge 12 ] 2>/dev/null || EXPAND_W=$SIDEBAR_W
[ "$EXPAND_W" -le 35 ] 2>/dev/null || EXPAND_W=35

HOST_PANE=$(cat "$STATE_DIR/host-pane" 2>/dev/null)
[ -n "$HOST_PANE" ] || exit 0
SB=$(cat "$STATE_DIR/sidebar-pane" 2>/dev/null)
MODE=$(cat "$STATE_DIR/mode" 2>/dev/null)

# 窗口宽度(attached 时等于 client 宽度; detached 也可用, 便于测试)
W=$(tmux display-message -p -t "$SESS:0" '#{window_width}' 2>/dev/null)
[ -n "$W" ] || exit 0

pane_w() { tmux display-message -p -t "$SB" '#{pane_width}' 2>/dev/null; }

# 侧栏面板不存在: 宽度足够且非手动折叠 → 重新切出
if [ -z "$SB" ]; then
  if [ "$W" -ge "$COLLAPSE_AT" ] && [ "$MODE" != "manual" ]; then
    tmux split-window -h -b -l "$EXPAND_W" -t "$HOST_PANE" \
      -c "$HOME" "$BIN_DIR/shannon-sidebar" && echo auto > "$STATE_DIR/mode"
  fi
  exit 0
fi

CW=$(pane_w)
[ -n "$CW" ] || exit 0

if [ "$W" -lt "$COLLAPSE_AT" ]; then
  # 窄窗口: 钉在 rail
  case "$CW" in [1-9]) ;; *) tmux resize-pane -t "$SB" -x "$RAIL_W" ;; esac
  echo auto-collapsed > "$STATE_DIR/mode"
else
  # 宽窗口: 手动折叠的尊重用户; 其余钉在记忆宽度
  if [ "$MODE" = "manual" ]; then
    case "$CW" in [1-9]) exit 0 ;; esac
  fi
  if [ "$CW" != "$EXPAND_W" ]; then
    tmux resize-pane -t "$SB" -x "$EXPAND_W"
  fi
  echo auto > "$STATE_DIR/mode"
fi
