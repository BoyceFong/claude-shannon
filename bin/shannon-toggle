#!/bin/sh
# shannon-toggle — 折叠/展开侧栏 (M-s、◀ 或 rail 上的 ▶)。
# 通过 main-pane-width + main-vertical 布局切换, 面板不销毁;
# 若布局未生效(面板次序异常)则退回 resize-pane 纠正。

BIN_DIR=$(cd "$(dirname "$0")" && pwd)
STATE_DIR="$HOME/.claude/shannon"
SESS="${SHANNON_SESSION:-shannon}"
. "$STATE_DIR/config" 2>/dev/null || true
SIDEBAR_W=${SIDEBAR_W:-35}
RAIL_W=${RAIL_W:-2}

# 展开宽度 = 用户记忆值, 限制在 [12, 35]
EXPAND_W=$(cat "$STATE_DIR/sidebar-w" 2>/dev/null || true)
case "$EXPAND_W" in ''|*[!0-9]*) EXPAND_W=$SIDEBAR_W ;; esac
[ "$EXPAND_W" -ge 12 ] 2>/dev/null || EXPAND_W=$SIDEBAR_W
[ "$EXPAND_W" -le 35 ] 2>/dev/null || EXPAND_W=35

SB=$(cat "$STATE_DIR/sidebar-pane" 2>/dev/null)
[ -n "$SB" ] || exit 0
CW=$(tmux display-message -p -t "$SB" '#{pane_width}' 2>/dev/null)
[ -n "$CW" ] || exit 0

case "$CW" in
  [1-9])
    TARGET=$EXPAND_W; MODE=auto      # rail → 展开(恢复记忆宽度)
    ;;
  *)
    TARGET=$RAIL_W; MODE=manual      # 完整 → rail(手动折叠, autofit 尊重)
    ;;
esac

tmux set-window-option -t "$SESS:0" main-pane-width "$TARGET" 2>/dev/null
tmux select-layout -t "$SESS:0" main-vertical 2>/dev/null
CW2=$(tmux display-message -p -t "$SB" '#{pane_width}' 2>/dev/null)
if [ "$CW2" != "$TARGET" ]; then
  tmux resize-pane -t "$SB" -x "$TARGET" 2>/dev/null
fi
echo "$MODE" > "$STATE_DIR/mode"
